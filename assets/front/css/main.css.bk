      border-width: 0 3.35px 4px 3.35px;
      border-color: transparent transparent #dea56a transparent; }
  .nsdi-theme .collapse-nav-toggle.active span {
    color: #1a1a1a; }
    .nsdi-theme .collapse-nav-toggle.active span:after {
      -webkit-transform: translate(-50%, 0) rotate(-90deg);
      -ms-transform: translate(-50%, 0) rotate(-90deg);
      transform: translate(-50%, 0) rotate(-90deg); }

