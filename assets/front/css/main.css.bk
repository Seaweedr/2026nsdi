      height: 100%; }
    .nsdi-theme .scroll-hint-wrap .scroll-hint-btn a:hover, .nsdi-theme .scroll-hint-wrap .scroll-hint-btn a:focus, .nsdi-theme .scroll-hint-wrap .scroll-hint-btn a:active, .nsdi-theme .scroll-hint-wrap .scroll-hint-btn a:checked {
      color: #fff; }
    .nsdi-theme .scroll-hint-wrap .scroll-hint-btn .letter-group {
      padding-left: 0px;
