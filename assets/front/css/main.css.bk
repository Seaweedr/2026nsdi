@charset "UTF-8";
body, html {
  margin: 0;
  padding: 0;
  word-break: normal;
  font-smoothing: antialiased;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  height: auto;
  text-align: left;
  overflow-x: hidden;
  letter-spacing: .5px;
  font-family: 'Open Sans', 'Noto Sans TC', "PingFang TC" ,"微軟正黑體",   "蘋果儷中黑",'sans-serif' , Arial;
  font-weight: 500;
  color: #ffffff;
  background-color: #353535; }

@media all and (max-width: 991px) {
  body {
    overflow-x: hidden !important; } }

a:focus, a:hover {
  text-decoration: none; }

body {
  position: relative;
  height: 100%; }

body.lock-scroll {
  overflow: hidden; }

.u-test {
  border: 0.5px solid rgba(255, 165, 0, 0.8); }

.u-test * {
  border: 0.5px solid rgba(255, 165, 0, 0.8); }

.u-dn {
  display: none; }

h1, h2, h3, h4, h5, h6, p, a, span, li {
  letter-spacing: .5px;
  font-weight: 500; }

.no__wrap {
  white-space: nowrap !important;
  display: inline-block; }

a {
  color: #ffffff; }
  a:hover {
    color: #ffffff; }

h1 {
  font-size: 56px; }

h2 {
  font-size: 48px; }

h3 {
  font-size: 24px; }

h4 {
  font-size: 18px; }

h5 {
  font-size: 12px; }

p, span, a, li {
  font-size: 16px; }

p {
  line-height: 1.7; }

section:not(.section-edit-wrap) ul {
  list-style: none;
  padding-left: 0; }

.section-edit-wrap a {
  color: #dea56a; }
  .section-edit-wrap a:hover {
    color: #dea56a; }

@media (max-width: 768px) {
  h1 {
    font-size: 40px; }
  h2 {
    font-size: 36px; }
  h3 {
    font-size: 24px; }
  h4 {
    font-size: 16px; }
  h5 {
    font-size: 12px; }
  p, span, a, li {
    font-size: 14px; } }

.main-btn-wrap {
  display: inline-block; }
  .main-btn-wrap .main-btn {
    display: inline-block;
    position: relative;
    background-color: transparent;
    border: 0;
    outline: 0;
    padding: 0px; }
    .main-btn-wrap .main-btn:focus {
      background-color: rgba(222, 165, 106, 0.1); }
    .main-btn-wrap .main-btn a {
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      padding: 12px 0;
      text-align: center; }
      .main-btn-wrap .main-btn a:before {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        left: 0;
        top: 0;
        -webkit-transform: scaleX(0);
        -ms-transform: scaleX(0);
        transform: scaleX(0);
        -webkit-transform-origin: right center;
        -ms-transform-origin: right center;
        transform-origin: right center;
        background-color: rgba(222, 165, 106, 0.1);
        -webkit-transition: -webkit-transform 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1);
        transition: -webkit-transform 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1);
        -o-transition: transform 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1);
        transition: transform 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1);
        transition: transform 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1), -webkit-transform 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1); }
      .main-btn-wrap .main-btn a span {
        position: relative;
        font-family: 'Open Sans', 'Noto Sans TC', "PingFang TC" ,"微軟正黑體",   "蘋果儷中黑",'sans-serif' , Arial;
        font-size: 14px;
        letter-spacing: 2.1px;
        color: #dea56a;
        left: 0px;
        padding: 0 38px;
        -webkit-transition: 1s cubic-bezier(0.23, 1, 0.32, 1);
        -o-transition: 1s cubic-bezier(0.23, 1, 0.32, 1);
        transition: 1s cubic-bezier(0.23, 1, 0.32, 1);
        z-index: 1; }
    .main-btn-wrap .main-btn .btn-border {
      position: absolute;
      background-color: #dea56a; }
      .main-btn-wrap .main-btn .btn-border:nth-child(odd) {
        width: 1px;
        height: 100%;
        bottom: 0;
        -webkit-transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
        -o-transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
        transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1); }
      .main-btn-wrap .main-btn .btn-border:nth-child(even) {
        height: 1px;
        width: 100%;
        -webkit-transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
        -o-transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
        transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1); }
      .main-btn-wrap .main-btn .btn-border:nth-child(1) {
        right: 0;
        -webkit-transform-origin: center center;
        -ms-transform-origin: center center;
        transform-origin: center center;
        -webkit-transition: all 0.8s 0.4s cubic-bezier(0.23, 1, 0.32, 1), -webkit-transform 0.4s 0s cubic-bezier(0.23, 1, 0.32, 1);
        transition: all 0.8s 0.4s cubic-bezier(0.23, 1, 0.32, 1), -webkit-transform 0.4s 0s cubic-bezier(0.23, 1, 0.32, 1);
        -o-transition: all 0.8s 0.4s cubic-bezier(0.23, 1, 0.32, 1), transform 0.4s 0s cubic-bezier(0.23, 1, 0.32, 1);
        transition: all 0.8s 0.4s cubic-bezier(0.23, 1, 0.32, 1), transform 0.4s 0s cubic-bezier(0.23, 1, 0.32, 1);
        transition: all 0.8s 0.4s cubic-bezier(0.23, 1, 0.32, 1), transform 0.4s 0s cubic-bezier(0.23, 1, 0.32, 1), -webkit-transform 0.4s 0s cubic-bezier(0.23, 1, 0.32, 1);
        -webkit-transition-delay: 0s;
        -o-transition-delay: 0s;
        transition-delay: 0s;
        -webkit-transform: translateY(0);
        -ms-transform: translateY(0);
        transform: translateY(0);
        max-height: 100%; }
      .main-btn-wrap .main-btn .btn-border:nth-child(2) {
        left: 0;
        top: 0;
        -webkit-transition-delay: .3s;
        -o-transition-delay: .3s;
        transition-delay: .3s;
        -webkit-transform-origin: left;
        -ms-transform-origin: left;
        transform-origin: left;
        -webkit-transform: scaleX(1);
        -ms-transform: scaleX(1);
        transform: scaleX(1); }
      .main-btn-wrap .main-btn .btn-border:nth-child(3) {
        left: 0;
        -webkit-transition-delay: .2s;
        -o-transition-delay: .2s;
        transition-delay: .2s;
        -webkit-transform-origin: bottom;
        -ms-transform-origin: bottom;
        transform-origin: bottom;
        -webkit-transform: scaleY(1);
        -ms-transform: scaleY(1);
        transform: scaleY(1); }
      .main-btn-wrap .main-btn .btn-border:nth-child(4) {
        bottom: 0;
        right: 0;
        left: initial;
        -webkit-transition-delay: 0s;
        -o-transition-delay: 0s;
        transition-delay: 0s;
        -webkit-transform-origin: left;
        -ms-transform-origin: left;
        transform-origin: left;
        max-width: 100%; }
  @media (min-width: 1200px) {
    .main-btn-wrap .main-btn:hover:before {
      -webkit-transform: rotate(45deg);
      -ms-transform: rotate(45deg);
      transform: rotate(45deg); }
    .main-btn-wrap .main-btn:hover:after {
      -webkit-transform: rotate(-45deg);
      -ms-transform: rotate(-45deg);
      transform: rotate(-45deg); }
    .main-btn-wrap .main-btn:hover a:before {
      -webkit-transform: scaleX(1);
      -ms-transform: scaleX(1);
      transform: scaleX(1);
      -webkit-transform-origin: left center;
      -ms-transform-origin: left center;
      transform-origin: left center; }
    .main-btn-wrap .main-btn:hover a span {
      left: 5px; }
    .main-btn-wrap .main-btn:hover .btn-border:nth-child(1) {
      -webkit-transform: translateY(50%);
      -ms-transform: translateY(50%);
      transform: translateY(50%);
      max-height: 20px;
      -webkit-transition: all 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1), -webkit-transform 0.2s 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      transition: all 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1), -webkit-transform 0.2s 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      -o-transition: all 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1), transform 0.2s 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      transition: all 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1), transform 0.2s 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      transition: all 0.8s 0.2s cubic-bezier(0.23, 1, 0.32, 1), transform 0.2s 0.4s cubic-bezier(0.23, 1, 0.32, 1), -webkit-transform 0.2s 0.4s cubic-bezier(0.23, 1, 0.32, 1); }
    .main-btn-wrap .main-btn:hover .btn-border:nth-child(2) {
      -webkit-transition-delay: 0s;
      -o-transition-delay: 0s;
      transition-delay: 0s;
      -webkit-transform: scaleX(0);
      -ms-transform: scaleX(0);
      transform: scaleX(0); }
    .main-btn-wrap .main-btn:hover .btn-border:nth-child(3) {
      -webkit-transition-delay: .2s;
      -o-transition-delay: .2s;
      transition-delay: .2s;
      -webkit-transform: scaleY(0);
      -ms-transform: scaleY(0);
      transform: scaleY(0); }
    .main-btn-wrap .main-btn:hover .btn-border:nth-child(4) {
      -webkit-transition: all 1.2s 0.2s cubic-bezier(0.23, 1, 0.32, 1), -webkit-transform 1s 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      transition: all 1.2s 0.2s cubic-bezier(0.23, 1, 0.32, 1), -webkit-transform 1s 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      -o-transition: all 1.2s 0.2s cubic-bezier(0.23, 1, 0.32, 1), transform 1s 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      transition: all 1.2s 0.2s cubic-bezier(0.23, 1, 0.32, 1), transform 1s 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      transition: all 1.2s 0.2s cubic-bezier(0.23, 1, 0.32, 1), transform 1s 0.4s cubic-bezier(0.23, 1, 0.32, 1), -webkit-transform 1s 0.4s cubic-bezier(0.23, 1, 0.32, 1);
      -webkit-transition-delay: .4s;
      -o-transition-delay: .4s;
      transition-delay: .4s;
      max-width: 25px;
      -webkit-transform-origin: right;
      -ms-transform-origin: right;
      transform-origin: right;
      right: -12.5px; } }

