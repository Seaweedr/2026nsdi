.nsdi-theme .collapse-nav-toggle {
  display: none;
  position: absolute;
  right: 0;
  height: 100%;
  width: 30px;
  top: 0;
  cursor: pointer; }
  .nsdi-theme .collapse-nav-toggle span {
    -webkit-writing-mode: vertical-lr;
    -ms-writing-mode: tb-lr;
    writing-mode: vertical-lr;
    text-transform: uppercase;
    padding: 120px 0px 40px;
    line-height: 30px;
    font-size: 12px;
    color: #dea56a;
    letter-spacing: 1.3px;
    -webkit-transition: .5s ease;
    -o-transition: .5s ease;
    transition: .5s ease;
    position: relative; }
    .nsdi-theme .collapse-nav-toggle span:after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: 0;
      -webkit-transform: translate(-50%, 0) rotate(90deg);
      -ms-transform: translate(-50%, 0) rotate(90deg);
      transform: translate(-50%, 0) rotate(90deg);
      width: 0;
      height: 0;
