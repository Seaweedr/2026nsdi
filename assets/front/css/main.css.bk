.clients-pages .main-container {
  margin-bottom: 40px; }

.clients-pages .section-edit-wrap {
  background-color: #fff;
  height: 100%;
  min-height: 100vh;
  padding: 100px 80px 50px;
  color: #333;
  text-align: left; }
  .clients-pages .section-edit-wrap img {
    max-width: 100%;
    height: auto !important; }
  .clients-pages .section-edit-wrap p {
    font-size: 16px;
    font-weight: normal;
    line-height: 1.8; }
  .clients-pages .section-edit-wrap .article-date {
    margin-bottom: 10px;
    font-size: 14px;
    line-height: 1;
    letter-spacing: 1px;
    font-weight: normal; }
    .clients-pages .section-edit-wrap .article-date span {
      font-size: inherit;
      letter-spacing: inherit;
      font-weight: inherit;
      line-height: inherit;
      margin-left: 23px;
      verticle-align: middle; }
  .clients-pages .section-edit-wrap h3.article-title {
    font-size: 60px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 3px;
    margin-bottom: 45px; }
  .clients-pages .section-edit-wrap .section-step {
    margin: 25px 0px 55px;
    padding: 45px 90px;
    border-top: 1px solid #979797;
    position: relative; }
    .clients-pages .section-edit-wrap .section-step:last-child {
      margin-bottom: 0px; }
    .clients-pages .section-edit-wrap .section-step:before {
      content: attr(data-step);
      padding: 17px;
      border-radius: 50%;
      background-color: #1a1a1a;
      color: #fff;
      font-size: 18px;
      min-width: 60px;
      text-align: center;
      letter-spacing: 1.9px;
      line-height: normal;
      font-weight: normal;
      position: absolute;
      left: 0px;
      top: 25px; }
    .clients-pages .section-edit-wrap .section-step p.title {
      font-size: 16px;
      font-weight: 500;
      line-height: 1.56;
      letter-spacing: 1.7px;
      margin-bottom: 40px; }
  .clients-pages .section-edit-wrap .note-block {
    padding: 40px 50px;
    border: solid 1.5px #d99956; }
    .clients-pages .section-edit-wrap .note-block p {
      color: #353535; }
    .clients-pages .section-edit-wrap .note-block p.title {
      font-size: 16px;
      font-weight: bold;
      line-height: 0.94;
      letter-spacing: 2.3px;
      color: #d99956;
      padding-bottom: 5px;
      margin-bottom: 20px;
      border-bottom: solid 1px #d99956;
      display: inline-block; }
  .clients-pages .section-edit-wrap .code-block {
    background-color: #f1f1f1;
    padding: 40px 50px 35px; }
    .clients-pages .section-edit-wrap .code-block pre {
      border: 0px;
      background-color: transparent; }
    .clients-pages .section-edit-wrap .code-block code {
      font-family: 'Noto Sans TC','Open Sans', "PingFang TC" , "微軟正黑體",   "蘋果儷中黑",'sans-serif' , Arial;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.64;
      letter-spacing: 1.5px;
      color: #1a1a1a; }
  .clients-pages .section-edit-wrap button.clipboard-btn {
    outline: 0;
    border: 1.5px solid #1a1a1a;
    padding: 10px 35px;
    text-align: center;
    background-color: transparent;
    -webkit-transition: .5s ease;
    -o-transition: .5s ease;
    transition: .5s ease;
    font-size: 14px;
    letter-spacing: 2.1px;
    color: #1a1a1a;
    margin-top: 35px; }

.clients-pages .section-contact {
  padding: 143px 30px 127px;
  background-image: url("../images/pages/clients/img_client_bottom.jpg");
  background-size: cover;
  background-position: center center;
  text-align: center;
  margin-top: 40px; }
  .clients-pages .section-contact h5 {
    font-size: 30px;
    font-weight: normal;
    line-height: 2;
    letter-spacing: 3px;
    color: #fff;
    margin-bottom: 25px; }
  .clients-pages .section-contact .sub-btn-pos {
    text-align: center; }
  .clients-pages .section-contact .sub-btn-wrap {
    width: 180px; }
    .clients-pages .section-contact .sub-btn-wrap .sub-btn a {
      padding: 14px 0; }
      .clients-pages .section-contact .sub-btn-wrap .sub-btn a span {
        font-size: 14px;
        letter-spacing: 2.1px;
        line-height: normal; }

@media all and (min-width: 992px) {
  .clients-pages .breadcrumb li:hover {
    opacity: 0.8; }
  .clients-pages .anchor-nav-box .anchor-item:hover {
    color: #dea56a;
    letter-spacing: 2.5px; }
  .clients-pages .section-edit-wrap {
    margin-left: -15px; }
    .clients-pages .section-edit-wrap button.clipboard-btn:hover {
      background-color: #1a1a1a;
      color: #fff; } }

@media all and (max-width: 1600px) {
  .clients-pages .section-edit-wrap {
    padding: 60px 60px 50px; }
    .clients-pages .section-edit-wrap .section-step {
      padding: 45px 25px; }
      .clients-pages .section-edit-wrap .section-step:before {
        position: relative;
        display: inline-block;
        left: 0;
        top: -20px; }
    .clients-pages .section-edit-wrap h3.article-title {
      font-size: 40px;
      margin-bottom: 30px; } }

@media all and (max-width: 991px) {
  .clients-pages {
    padding-left: 30px; } }

@media all and (max-width: 768px) {
  .clients-pages .section-edit-wrap {
    padding: 60px 35px 40px; }
    .clients-pages .section-edit-wrap .section-step {
      padding: 45px 0px; }
    .clients-pages .section-edit-wrap .article-date {
      margin-bottom: 15px; }
    .clients-pages .section-edit-wrap h3.article-title {
      font-size: 28px; }
    .clients-pages .section-edit-wrap .note-block {
      padding: 30px 25px; }
    .clients-pages .section-edit-wrap .code-block {
      padding: 30px 30px 35px; }
  .clients-pages .section-contact h5 {
    font-size: 24px; } }

.nsdi-web-app-list section {
  background-color: #000;
  position: relative; }

.nsdi-web-app-list .main-header {
  position: relative;
  height: 350px;
  opacity: 0;
  top: 0;
  width: 100%;
  height: 50vh;
  min-height: 300px;
  max-height: 450px;
  background-position: center center;
  background-repeat: no-repeat;
  background-size: cover;
  position: relative; }
  .nsdi-web-app-list .main-header::after {
    display: none; }
  .nsdi-web-app-list .main-header .bg-img {
    position: absolute;
    top: 0;
    right: 75px;
    width: 450px; }
    .nsdi-web-app-list .main-header .bg-img img {
      width: 100%;
      height: auto; }
  .nsdi-web-app-list .main-header h1.title {
    position: absolute;
    top: 50%;
    left: 47px;
    -webkit-transform: translate(0, -50%);
    -ms-transform: translate(0, -50%);
    transform: translate(0, -50%);
    color: #fff;
    position: relative;
    font-size: 0px;
    text-transform: capitalize; }
    .nsdi-web-app-list .main-header h1.title span {
      display: inline-block;
      vertical-align: top;
      line-height: normal; }
    .nsdi-web-app-list .main-header h1.title span.en {
      font-size: 36px;
      font-weight: bold;
      font-family: 'Lato', 'Noto Sans TC', "PingFang TC" ,"微軟正黑體",   "蘋果儷中黑",'sans-serif' , Arial;
      letter-spacing: -0.7px; }
    .nsdi-web-app-list .main-header h1.title span.cn {
      font-size: 12px;
      margin-left: 5px;
      letter-spacing: 0.1px; }

.nsdi-web-app-list ul.main-list {
  margin: 0;
  padding: 0;
  font-size: 0px;
  letter-spacing: 0px;
  text-align: left;
  color: #fff; }

.nsdi-web-app-list li.main-item {
  margin: 0;
  padding: 0;
  list-style-type: none;
  position: relative;
