  transform-style: preserve-3d; }

.t-mt-wrap {
  position: absolute;
  width: 100%;
  height: 100%;
  background-position: center center;
  background-repeat: no-repeat;
  background-size: cover;
  width: 100%;
  height: 100%;
  background-repeat: no-repeat;
  -webkit-transition: bottom 0.8s cubic-bezier(0.39, 0.575, 0.565, 1);
  -o-transition: bottom 0.8s cubic-bezier(0.39, 0.575, 0.565, 1);
  transition: bottom 0.8s cubic-bezier(0.39, 0.575, 0.565, 1); }

