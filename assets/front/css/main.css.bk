.loaded .nsdi-web-app-list .main-header {
  -webkit-animation: fadeIn both 2.5s .5s;
  animation: fadeIn both 2.5s .5s; }

.loaded .nsdi-web-app-list li.main-item {
  -webkit-transform: translateX(0);
  -ms-transform: translateX(0);
  transform: translateX(0);
  opacity: 1; }

@media all and (min-width: 1200px) {
  .nsdi-web-app-list .main-header {
    position: absolute;
    left: 0;
    top: 50%;
    -webkit-transform: translate(0, -50%);
    -ms-transform: translate(0, -50%);
    transform: translate(0, -50%);
    height: 100%; }
    .nsdi-web-app-list .main-header .bg-img {
      right: initial;
      top: initial;
      left: 8%;
      width: 45%;
      bottom: 0; }
  .nsdi-web-app-list .main-body {
    position: relative;
    left: 100%;
    -webkit-transform: translate(-100%, 0);
    -ms-transform: translate(-100%, 0);
    transform: translate(-100%, 0);
    width: 60%; } }

@media all and (min-width: 992px) {
  .nsdi-web-app-list .main-list:hover .main-item {
    -webkit-filter: grayscale(0.5);
    filter: grayscale(0.5); }
  .nsdi-web-app-list .main-list:hover .main-item:hover {
    -webkit-filter: grayscale(0);
    filter: grayscale(0); }
  .nsdi-web-app-list .main-item:hover img {
    width: 110%; }
  .nsdi-web-app-list .main-item:hover span.more {
    padding-left: 5px; }
    .nsdi-web-app-list .main-item:hover span.more:after {
      margin-left: 10px; } }

@media all and (max-width: 991px) {
  .nsdi-web-app-list li.main-item {
    width: calc(100% / 2);
    padding-top: calc(100% / 2 / 384 * 490); }
  .nsdi-web-app-list .main-header {
    max-height: 320px; } }

@media all and (max-width: 768px) {
  .nsdi-web-app-list li.main-item {
    font-size: 14px; }
    .nsdi-web-app-list li.main-item img {
      opacity: 0.7; } }

@media all and (max-width: 480px) {
  .nsdi-web-app-list .main-header .bg-img {
    top: 0;
    right: -50px;
    width: 450px; }
  .nsdi-web-app-list li.main-item span.more {
    letter-spacing: 1px; } }

