      -webkit-line-clamp: 2; } }

@media all and (min-width: 769px) {
  .nsdi-theme.nsdi-clients .section-sort li.sort-item:hover a {
    border: 5px solid #dea56a; }
  .nsdi-theme.nsdi-clients .section-sort li.sort-item:hover:before {
    opacity: 0; }
  .nsdi-theme.nsdi-clients .section-sort li.sort-item:hover .sort-img {
