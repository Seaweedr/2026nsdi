.editor-section .container {
  width: 100% !important; }

@media all and (max-width: 991px) {
  .nsdi-works-page .section-edit-wrap {
    margin-left: -15px;
    margin-right: -15px; } }

.clients-pages .editor-section .nsdi-article-system {
  overflow: visible; }

.clients-pages .editor-section .nas-article {
  width: 100%;
  padding: 0; }

.clients-pages .editor-section img {
  width: auto;
  max-width: 100%; }

.reveal-content-wrap {
  width: 100%;
  position: relative;
  overflow: hidden; }
  .reveal-content-wrap .reveal-content {
    width: 100%;
    opacity: 0;
    -webkit-transition: opacity 1s .5s;
    -o-transition: opacity 1s .5s;
    transition: opacity 1s .5s; }
    .reveal-content-wrap .reveal-content img {
      width: 100%; }
  .reveal-content-wrap .reveal-content.active {
    opacity: 1; }

.reveal {
  position: absolute; }

.reveal.reveal-l {
  width: 0;
  height: 100%;
  top: 0;
  left: 0; }

.reveal.reveal-r {
  width: 0;
  height: 100%;
  top: 0;
  right: 0; }

.reveal.reveal-t {
  width: 100%;
  height: 0;
  left: 0;
  top: 0; }

.reveal.reveal-b {
  width: 100%;
  height: 0;
  left: 0;
  bottom: 0; }

.reveal.gray {
  background-color: #353535; }

.revealAniR {
  -webkit-animation: revealAniR 1s cubic-bezier(0.19, 1, 0.22, 1);
  animation: revealAniR 1s cubic-bezier(0.19, 1, 0.22, 1); }

.revealAniL {
  -webkit-animation: revealAniL 1s cubic-bezier(0.19, 1, 0.22, 1);
  animation: revealAniL 1s cubic-bezier(0.19, 1, 0.22, 1); }

.revealAniT {
  -webkit-animation: revealAniT 1s cubic-bezier(0.19, 1, 0.22, 1);
  animation: revealAniT 1s cubic-bezier(0.19, 1, 0.22, 1); }

.revealAniB {
  -webkit-animation: revealAniB 1s cubic-bezier(0.19, 1, 0.22, 1);
  animation: revealAniB 1s cubic-bezier(0.19, 1, 0.22, 1); }

@-webkit-keyframes revealAniL {
  0% {
    width: 0%;
    left: 0%; }
  50% {
    width: 100%;
    left: 0%; }
  100% {
    width: 0%;
    left: 100%; } }

@keyframes revealAniL {
  0% {
    width: 0%;
    left: 0%; }
  50% {
    width: 100%;
    left: 0%; }
  100% {
    width: 0%;
    left: 100%; } }

@-webkit-keyframes revealAniR {
  0% {
    width: 0%;
    right: 0%; }
  50% {
    width: 100%;
    right: 0%; }
  100% {
    width: 0%;
    right: 100%; } }

@keyframes revealAniR {
  0% {
    width: 0%;
    right: 0%; }
  50% {
    width: 100%;
    right: 0%; }
  100% {
    width: 0%;
    right: 100%; } }

@-webkit-keyframes revealAniT {
  0% {
    height: 0%;
    top: 0%; }
  50% {
    height: 100%;
    top: 0%; }
  100% {
    height: 0%;
    top: 100%; } }

@keyframes revealAniT {
  0% {
    height: 0%;
    top: 0%; }
  50% {
    height: 100%;
    top: 0%; }
  100% {
    height: 0%;
    top: 100%; } }

@-webkit-keyframes revealAniB {
  0% {
    height: 0%;
    bottom: 0%; }
  50% {
    height: 100%;
    bottom: 0%; }
  100% {
    height: 0%;
    bottom: 100%; } }

@keyframes revealAniB {
  0% {
    height: 0%;
    bottom: 0%; }
  50% {
    height: 100%;
    bottom: 0%; }
  100% {
    height: 0%;
    bottom: 100%; } }

.ellip {
  display: block;
  height: 100%; }

.ellip-line {
  display: inline-block;
  -o-text-overflow: ellipsis;
  text-overflow: ellipsis;
  white-space: nowrap;
  word-wrap: normal; }

.ellip, .ellip-line {
  position: relative;
  overflow: hidden;
  max-width: 100%; }
