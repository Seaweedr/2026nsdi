.side-nav {
  z-index: 100;
  position: fixed;
  left: 45px;
  top: 50%;
  -webkit-transform: translateY(-50%);
  -ms-transform: translateY(-50%);
  transform: translateY(-50%);
  color: rgba(255, 255, 255, 0.4); }
  .side-nav .side-nav-item {
    position: relative;
    padding: 7.5px 15px 7.5px 22px;
    -webkit-transition: all .8s ease-out;
    -o-transition: all .8s ease-out;
    transition: all .8s ease-out;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none; }
    .side-nav .side-nav-item:before {
      content: '';
      position: absolute;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      left: 0;
      top: 50%;
      -webkit-transform: translateY(-50%);
      -ms-transform: translateY(-50%);
      transform: translateY(-50%);
      border: 1px solid rgba(255, 255, 255, 0.4);
      -webkit-transition: 1s cubic-bezier(0.23, 1, 0.32, 1);
      -o-transition: 1s cubic-bezier(0.23, 1, 0.32, 1);
      transition: 1s cubic-bezier(0.23, 1, 0.32, 1); }
    .side-nav .side-nav-item .side-nav-link {
      vertical-align: middle;
      padding: 7.5px 5px 7.5px 0px;
      color: rgba(255, 255, 255, 0.4);
      font-size: 14px;
      letter-spacing: 1.8px;
      -webkit-transition: 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      -o-transition: 0.3s cubic-bezier(0.23, 1, 0.32, 1);
      transition: 0.3s cubic-bezier(0.23, 1, 0.32, 1); }
    .side-nav .side-nav-item .side-nav-bullet {
      vertical-align: middle;
      display: inline-block;
      position: relative;
      width: 20px;
      margin-right: 2px;
      overflow: hidden;
      padding: 7.5px 0px 7.5px 0px; }
      .side-nav .side-nav-item .side-nav-bullet:after, .side-nav .side-nav-item .side-nav-bullet:before {
        content: '';
        width: 100%;
        height: 1px;
        position: absolute; }
      .side-nav .side-nav-item .side-nav-bullet:before {
        background-color: rgba(255, 255, 255, 0.4); }
      .side-nav .side-nav-item .side-nav-bullet:after {
        background-color: #ffffff;
        -webkit-transform: translateX(-100%);
        -ms-transform: translateX(-100%);
        transform: translateX(-100%);
        -webkit-transition: 1s;
        -o-transition: 1s;
        transition: 1s;
        -webkit-transition-timing-function: cubic-bezier(0.7, 0, 0.3, 1);
        -o-transition-timing-function: cubic-bezier(0.7, 0, 0.3, 1);
        transition-timing-function: cubic-bezier(0.7, 0, 0.3, 1); }
      .side-nav .side-nav-item .side-nav-bullet.active:after {
        -webkit-transform: translateX(0%);
        -ms-transform: translateX(0%);
        transform: translateX(0%); }
    .side-nav .side-nav-item.active .side-nav-link {
      color: #ffffff; }
    .side-nav .side-nav-item.active:before {
      border: 1px solid white;
      background-color: #ffffff; }
    .side-nav .side-nav-item:hover {
      letter-spacing: 3px;
      margin-left: 12px; }
      .side-nav .side-nav-item:hover .side-nav-link {
        letter-spacing: 3.5px;
        margin-left: 5px; }
      .side-nav .side-nav-item:hover .side-nav-bullet {
        width: 25px;
        margin-right: 3px; }

