  -ms-transform-style: none; }

.ie .t-img-fox-rellax {
  -ms-transform-style: none; }

.ie .t-logo-rellax {
  -ms-transform-style: none; }

.ie .t-logo-wraps {
  -ms-transform-style: none; }

.ie .t-logo-wrap {
  -ms-transform-style: none; }

.nsdi-theme .scroll-hint-wrap {
