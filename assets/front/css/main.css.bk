    height: 100%;
    top: 0;
    left: 0;
    background: rgba(0, 0, 0, 0.8);
    display: block;
    z-index: 2; }
  .nsdi-theme.nsdi-design-spec.nsdi-app-spec .section-04 .section-intro {
    margin-bottom: 150px; }

@media all and (max-width: 768px) {
  .nsdi-theme.nsdi-design-spec.nsdi-app-spec .section-04 {
    background-attachment: scroll;
    background-attachment: initial; } }

.sitemap-wrap {
  background-image: url("../images/bg_menu-blur.jpg");
  background-size: cover;
  background-position: center center;
  width: 100vw;
  min-height: calc(100vh - 230px);
  color: #fff;
  display: block;
  opacity: 1;
  -webkit-transition: ease-out .5s, background-color .5s  ease;
  -o-transition: ease-out .5s, background-color .5s  ease;
  transition: ease-out .5s, background-color .5s  ease; }
  .sitemap-wrap h1, .sitemap-wrap h2, .sitemap-wrap h3, .sitemap-wrap h4, .sitemap-wrap h5, .sitemap-wrap h6, .sitemap-wrap p, .sitemap-wrap a, .sitemap-wrap span, .sitemap-wrap li {
    font-family: 'Open Sans', 'Noto Sans TC', "PingFang TC" ,"微軟正黑體",   "蘋果儷中黑",'sans-serif' , Arial; }
  .sitemap-wrap h1.main-title {
    position: relative;
    max-width: 420px;
    margin-bottom: 50px;
    font-size: 0; }
    .sitemap-wrap h1.main-title span.en {
      font-family: 'Lato', 'Noto Sans TC', "PingFang TC" ,"微軟正黑體",   "蘋果儷中黑",'sans-serif' , Arial;
      text-transform: uppercase;
      font-size: 60px;
      font-weight: bold;
      letter-spacing: 2.4px;
      line-height: normal;
      margin-right: 65px; }
    .sitemap-wrap h1.main-title span.cn {
      font-size: 18px;
      font-weight: normal;
      line-height: normal;
      letter-spacing: 1.5px;
      position: absolute;
      bottom: 10px;
      right: 0; }

.sitemap-list {
  margin-top: -25px; }
  .sitemap-list .link-main-list {
    margin-bottom: 50px; }
  .sitemap-list .column-wrap {
    -webkit-column-count: 2;
    column-count: 2; }
  .sitemap-list a {
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    color: inherit; }
  .sitemap-list h4 {
    font-size: 24px;
    font-weight: bold;
    line-height: normal;
    letter-spacing: 2.7px;
    color: #ffffff;
    margin: 25px 0; }
  .sitemap-list h5 {
    font-size: 18px;
    font-weight: 300;
    line-height: normal;
    letter-spacing: 2px;
    color: #ffffff;
    margin-bottom: 15px; }
  .sitemap-list .link-sub-list ul {
    padding: 5px 0 30px; }
  .sitemap-list .link-sub-list li {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.14;
    letter-spacing: 1.6px;
    color: #ffffff;
    margin-bottom: 8px; }
    .sitemap-list .link-sub-list li:before {
      content: '- '; }

.sitemap-container {
  padding: 175px 0px 80px; }
  .sitemap-container .main-title {
    -webkit-transition: .5s .3s ease-out, opacity .5s .3s ease;
    -o-transition: .5s .3s ease-out, opacity .5s .3s ease;
    transition: .5s .3s ease-out, opacity .5s .3s ease;
    opacity: 1;
    -webkit-transform: translate(0, 0);
    -ms-transform: translate(0, 0);
    transform: translate(0, 0); }

@media all and (max-width: 1199px) {
  .sitemap-container {
    padding: 180px 25px 80px; } }

@media all and (max-width: 768px) {
  .sitemap-wrap h1.main-title span.en {
    font-size: 40px;
    font-weight: normal; }
  .sitemap-wrap h1.main-title span.cn {
    font-size: 16px;
    letter-spacing: 1.3px; } }

@media all and (max-width: 576px) {
  .sitemap-container {
    padding: 180px 25px 80px; }
  .sitemap-list .column-wrap {
    -webkit-column-count: 1;
    column-count: 1; } }

@media all and (min-width: 1200px) and (max-width: 1599px) {
  .sitemap-container .container {
    width: 1170px; }
  .sitemap-wrap h1.main-title span.en {
    font-size: 48px;
    letter-spacing: 2px; } }

@media all and (min-width: 1600px) {
  .sitemap-container .container {
    width: 1480px; } }

.search-results .results-container {
  padding: 110px 45px; }

.search-results h1.main-title {
  font-size: 1.8rem;
  font-weight: 500;
  font-style: normal;
  font-stretch: normal;
  line-height: normal;
  letter-spacing: 2.7px;
  color: #dea56a; }
  .search-results h1.main-title span {
    color: #fff;
    font-size: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    padding: 0 10px; }

.search-results .results-head {
  padding: 40px 0;
  border-bottom: 1px solid #fff; }

.search-results .results-list .item {
  border-bottom: 1px solid #fff;
  padding: 60px 0;
  position: relative;
  -webkit-transition: .3s ease;
  -o-transition: .3s ease;
  transition: .3s ease; }

.search-results .results-list .link {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%; }

.search-results .results-list .tag {
  font-size: 1.8rem;
  font-weight: normal;
  line-height: 0.83;
  letter-spacing: 2.6px;
  color: #dea56a;
  padding-bottom: 7px;
  display: inline-block;
  padding-left: 2.6px;
  margin-bottom: 20px;
  border-bottom: 1px solid #dea56a; }

.search-results .results-list h2.title {
  margin: 10px 0;
  font-size: 3rem;
  font-weight: 600;
  line-height: normal;
  letter-spacing: 3.3px;
  color: #ffffff; }

.search-results .results-list p.intro {
  font-size: 1.4rem;
  font-weight: normal;
  line-height: 2.36;
  letter-spacing: 1.8px;
  color: #ffffff;
  overflow: hidden;
  -o-text-overflow: ellipsis;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical; }

.search-results .main-btn-pos {
  text-align: center;
  padding: 90px 0 30px; }

@media all and (min-width: 1200px) {
  .search-results .results-list p.intro {
    padding-right: 6%; }
  .search-results .results-list:hover .item {
    opacity: 0.6; }
  .search-results .results-list:hover .item:hover {
    opacity: 1; } }

@media all and (max-width: 768px) {
  .search-results h1.main-title {
    font-size: 1.6rem; }
  .search-results .results-list .tag {
    font-size: 1.4rem; }
  .search-results .results-list h2.title {
    font-size: 2.4rem; } }

@media all and (max-width: 576px) {
  .search-results .results-container {
    padding: 110px 20px; } }

