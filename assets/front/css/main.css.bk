.t-logo-rellax {
  position: relative;
  height: 100vh;
  width: 100%;
  z-index: 10;
  -webkit-transform-style: preserve-3d;
  transform-style: preserve-3d; }

.t-logo-wraps {
  -webkit-transform-style: preserve-3d;
  transform-style: preserve-3d;
  position: absolute;
  width: 100%;
  height: 100%;
  top: -50%;
  -webkit-transition: top 0.8s 0.4s cubic-bezier(0.08, 0.6, 0.56, 1);
  -o-transition: top 0.8s 0.4s cubic-bezier(0.08, 0.6, 0.56, 1);
  transition: top 0.8s 0.4s cubic-bezier(0.08, 0.6, 0.56, 1); }

.loaded .t-logo-wraps {
  top: 50%;
  -webkit-transform: translate(0, -50%);
  -ms-transform: translate(0, -50%);
  transform: translate(0, -50%); }

.t-logo-wrap {
  position: absolute;
  top: calc( 50% - 66px);
  -webkit-transform-style: preserve-3d;
  transform-style: preserve-3d; }

.t-logo-wrap.no1 {
  left: calc( 50% - 132px - 120px - 25px); }

.t-logo-wrap.no2 {
  left: calc( 50% - 132px - 5px); }

.t-logo-wrap.no3 {
  left: calc( 50% + 5px); }

.t-logo-wrap.no4 {
  left: calc( 50% + 120px + 25px); }

