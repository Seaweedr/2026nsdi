.nsdi-theme.nsdi-clients .section-sort {
  padding-bottom: 15px;
  padding-top: 30px; }
  .nsdi-theme.nsdi-clients .section-sort ul.sort-list {
    margin: 0;
    padding: 0;
    font-size: 0px;
    letter-spacing: 0px;
    text-align: left;
    display: -webkit-box;
    display: -ms-flexbox;
    display: flex;
    -ms-flex-wrap: wrap;
    flex-wrap: wrap;
    -webkit-box-pack: start;
    -ms-flex-pack: start;
    justify-content: flex-start;
    margin: 0 -7.5px; }
  .nsdi-theme.nsdi-clients .section-sort li.sort-item {
    list-style-type: none;
    display: inline-block;
    position: relative;
    letter-spacing: 0px;
    margin: 0 7.5px 15px;
    width: calc(100% / 3 - 15px);
    overflow: hidden; }
    .nsdi-theme.nsdi-clients .section-sort li.sort-item .sort-img {
      width: 100%;
      height: 100%;
      position: absolute;
      left: 50%;
      top: 50%;
      -webkit-transform: translate(-50%, -50%);
      -ms-transform: translate(-50%, -50%);
      transform: translate(-50%, -50%);
      background-position: center center;
      background-size: cover;
      z-index: 0;
      -webkit-transition: .8s ease;
      -o-transition: .8s ease;
      transition: .8s ease;
      -webkit-filter: grayscale(5);
      filter: grayscale(5);
      -webkit-transform: translate(-50%, -50%) scale(1);
      -ms-transform: translate(-50%, -50%) scale(1);
      transform: translate(-50%, -50%) scale(1);
      -webkit-transform-origin: center center;
      -ms-transform-origin: center center;
      transform-origin: center center; }
    .nsdi-theme.nsdi-clients .section-sort li.sort-item:before {
      content: '';
      width: 105%;
      height: 105%;
      position: absolute;
      left: 50%;
      top: 50%;
      -webkit-transform: translate(-50%, -50%);
      -ms-transform: translate(-50%, -50%);
      transform: translate(-50%, -50%);
      z-index: 1;
      background-color: rgba(0, 0, 0, 0.4);
      -webkit-transition: .8s ease;
      -o-transition: .8s ease;
      transition: .8s ease; }
    .nsdi-theme.nsdi-clients .section-sort li.sort-item a {
      position: relative;
      z-index: 2;
      text-align: center;
      display: block;
      letter-spacing: 3px;
      color: #fff;
      font-size: 24px;
      font-weight: 500;
      padding: 52px 25px;
      border: 5px solid rgba(255, 255, 255, 0);
      -webkit-transition: .8s ease;
      -o-transition: .8s ease;
      transition: .8s ease;
      -webkit-transform: translateZ(0);
      transform: translateZ(0); }

.nsdi-theme.nsdi-clients .section-FAQ {
  margin-top: 60px;
  margin-bottom: 15px; }
  .nsdi-theme.nsdi-clients .section-FAQ .FAQ-list-wrap {
    margin-left: -10px;
    margin-right: -10px; }
  .nsdi-theme.nsdi-clients .section-FAQ .FAQ-item {
    margin: 0px 10px;
    padding: 25px 5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    font-size: 0px;
    position: relative;
    white-space: nowrap;
    -webkit-transition: .3s ease;
    -o-transition: .3s ease;
    transition: .3s ease; }
    .nsdi-theme.nsdi-clients .section-FAQ .FAQ-item:first-child {
      border-top: 1px solid rgba(255, 255, 255, 0.4); }
    .nsdi-theme.nsdi-clients .section-FAQ .FAQ-item:after {
      content: '';
      position: absolute;
      width: 12px;
      height: 12px;
      top: 50%;
      right: 30px;
      -webkit-transform: translate(-30px, -50%) rotate(45deg);
      -ms-transform: translate(-30px, -50%) rotate(45deg);
      transform: translate(-30px, -50%) rotate(45deg);
      border-top: 1px solid #dea56a;
      border-right: 1px solid #dea56a;
      opacity: 0;
      -webkit-transition: .8s ease;
      -o-transition: .8s ease;
      transition: .8s ease; }
  .nsdi-theme.nsdi-clients .section-FAQ h3.main-title {
    font-size: 30px;
    font-weight: normal;
    line-height: normal;
    letter-spacing: 4.3px;
    margin-bottom: 40px;
    color: #fff; }
  .nsdi-theme.nsdi-clients .section-FAQ .FAQ-tag {
    font-size: 16px;
    font-weight: normal;
    line-height: normal;
    letter-spacing: 2.3px;
    margin-right: 30px;
    color: #fff;
    padding: 5px 20px;
    display: inline-block;
    vertical-align: middle;
    border: 1px solid rgba(255, 255, 255, 0.4);
    -webkit-transition: .3s ease;
    -o-transition: .3s ease;
    transition: .3s ease; }
  .nsdi-theme.nsdi-clients .section-FAQ .FAQ-title {
    display: inline-block;
    vertical-align: middle;
    white-space: normal;
    width: calc(100% - 120px - 30px);
    padding: 0px 66px 0px 0px; }
    .nsdi-theme.nsdi-clients .section-FAQ .FAQ-title p {
      overflow: hidden;
      -o-text-overflow: ellipsis;
      text-overflow: ellipsis;
      white-space: nowrap;
      text-align: left;
      letter-spacing: 1.8px;
      line-height: normal;
      -webkit-transition: .3s ease;
      -o-transition: .3s ease;
      transition: .3s ease; }
  .nsdi-theme.nsdi-clients .section-FAQ .FAQ-link {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%; }

@media all and (min-width: 992px) {
  .nsdi-theme .section-nav {
    padding-right: 15px; } }

@media all and (max-width: 991px) {
  .nsdi-theme .sticky-wrapper {
    height: 0 !important; }
  .nsdi-theme .collapse-nav-container {
    position: relative;
    padding: 40px 30px 52px; }
  .nsdi-theme .collapse-nav-toggle {
    display: block; }
  .nsdi-theme .collapse-nav {
    position: fixed;
    max-height: 100%;
    min-height: 100vh;
    overflow-y: auto;
    left: 0;
    top: 0;
    -webkit-transform: translate(calc(-100% + 30px), 0);
    -ms-transform: translate(calc(-100% + 30px), 0);
    transform: translate(calc(-100% + 30px), 0);
    -webkit-transition: -webkit-transform .5s ease-out;
    transition: -webkit-transform .5s ease-out;
    -o-transition: transform .5s ease-out;
    transition: transform .5s ease-out;
    transition: transform .5s ease-out, -webkit-transform .5s ease-out;
    z-index: 10;
    background-color: #1a1a1a;
    -webkit-overflow-scrolling: touch;
    width: 360px;
    max-width: 100%; }
    .nsdi-theme .collapse-nav.active {
      -webkit-transform: translate(0, 0);
      -ms-transform: translate(0, 0);
      transform: translate(0, 0);
      z-index: 100003; }
  .nsdi-theme .client-side-nav span.main-item-toggle {
    background-color: #222; } }

@media all and (max-width: 768px) {
  .nsdi-theme.nsdi-clients .section-sort ul.sort-list {
    -webkit-box-pack: justify;
    -ms-flex-pack: justify;
    justify-content: space-between; }
  .nsdi-theme.nsdi-clients .section-sort li.sort-item {
    width: calc(100% / 2 - 15px); }
